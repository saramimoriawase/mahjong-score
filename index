function editGroup(id){const g=data.groups.find(x=>x.id===id);editingGroupId=id;$('groupName').value=g.name;$('groupMode').value=g.mode;renderGroupMemberSelects();g.members.forEach((m,i)=>{if($('gm_'+i))$('gm_'+i).value=m});$('groupRate').value=g.rate;$('groupChipRate').value=g.chipRate;$('groupStart').value=g.start;$('groupReturn').value=g.return;$('groupRules').value=g.rules;$('cancelGroupEditBtn').classList.remove('hidden')}
function renderGroups(){$('groupList').innerHTML=data.groups.length?data.groups.map(g=>'<div class="group-item"><div><b>'+esc(g.name)+'</b> <span class="badge">'+(g.mode===3?'三麻':'四麻')+'</span><div class="group-meta">'+esc(g.members.join('・')||'メンバー未設定')+' / '+g.rate+'円・チップ'+g.chipRate+'円</div></div><div><button class="mini edit" data-group-edit="'+g.id+'">編集</button> <button class="mini del" data-group-del="'+g.id+'">削除</button></div></div>').join(''):'<div class="empty">保存済みルールはありません。</div>';document.querySelectorAll('[data-group-edit]').forEach(b=>b.onclick=()=>editGroup(b.dataset.groupEdit));document.querySelectorAll('[data-group-del]').forEach(b=>b.onclick=()=>{if(!confirm('このグループを削除しますか？'))return;data.groups=data.groups.filter(g=>g.id!==b.dataset.groupDel);save();renderAll()})}
function renderGroupOptions(){const selected=$('gameGroup')?.value||'';$('gameGroup').innerHTML='<option value="">使用しない</option>'+data.groups.filter(g=>g.mode===currentMode()).map(g=>'<option value="'+g.id+'">'+esc(g.name)+'</option>').join('');if([...$('gameGroup').options].some(o=>o.value===selected))$('gameGroup').value=selected;const selectedAnalysisGroup=$('analysisGroup')?.value||'all',selectedAnalysisMember=$('analysisMember')?.value||'all',selectedAnalysisDate=$('analysisDate')?.value||'all';$('analysisGroup').innerHTML='<option value="all">すべて</option>'+data.groups.map(g=>'<option value="'+g.id+'">'+esc(g.name)+'</option>').join('');$('analysisMember').innerHTML='<option value="all">全メンバー</option>'+data.members.map(m=>'<option value="'+esc(m.name)+'">'+esc(m.name)+'</option>').join('');const dates=[...new Set(data.games.map(g=>g.date).filter(Boolean))].sort((a,b)=>String(b).localeCompare(String(a)));$('analysisDate').innerHTML='<option value="all">すべて</option>'+dates.map(d=>'<option value="'+esc(d)+'">'+esc(String(d).replace(/-/g,'/'))+'</option>').join('');if([...$('analysisGroup').options].some(o=>o.value===selectedAnalysisGroup))$('analysisGroup').value=selectedAnalysisGroup;if([...$('analysisMember').options].some(o=>o.value===selectedAnalysisMember))$('analysisMember').value=selectedAnalysisMember;if([...$('analysisDate').options].some(o=>o.value===selectedAnalysisDate))$('analysisDate').value=selectedAnalysisDate}
function aggregate(name='all',mode='all',group='all',date='all'){const games=data.games.filter(g=>(mode==='all'||String(g.mode)===String(mode))&&(group==='all'||g.groupId===group)&&(date==='all'||g.date===date)&&(name==='all'||Object.values(g.names).includes(name)));const stats={};games.forEach(g=>{const arr=Object.keys(g.scores).map(k=>({k,name:g.names[k],score:Number(g.scores[k])||0,chip:Number(g.chips[k])||0})).sort((a,b)=>b.score-a.score);let rank=1,prev=null;arr.forEach((x,i)=>{if(prev!==null&&x.score<prev)rank=i+1;prev=x.score;if(!stats[x.name])stats[x.name]={games:0,rankSum:0,first:0,last:0,ranks:{1:0,2:0,3:0,4:0},points:0,money:0,chips:0,series:[]};const s=stats[x.name];s.games++;s.rankSum+=rank;s.ranks[rank]=(s.ranks[rank]||0)+1;if(rank===1)s.first++;if(rank===g.mode)s.last++;s.points+=x.score;s.chips+=x.chip;s.money+=x.score*g.rate+x.chip*g.chipRate;s.series.push({date:g.date,delta:x.score})})});return{games,stats}}
function renderAnalysis(){if(!$('analysisSummary'))return;const name=$('analysisMember').value||'all',date=$('analysisDate').value||'all',mode=$('analysisMode').value||'all',group=$('analysisGroup').value||'all',a=aggregate(name,mode,group,date),list=Object.entries(a.stats);let totalGames=name==='all'?a.games.length:(a.stats[name]?.games||0),points=name==='all'?list.reduce((x,[,s])=>x+s.points,0):a.stats[name]?.points||0,moneyV=name==='all'?list.reduce((x,[,s])=>x+s.money,0):a.stats[name]?.money||0;let avg=name==='all'?'—':(a.stats[name]?.games?(a.stats[name].rankSum/a.stats[name].games).toFixed(2):'—'),top=name==='all'?'—':(a.stats[name]?.games?(a.stats[name].first/a.stats[name].games*100).toFixed(1)+'%':'—'),last=name==='all'?'—':(a.stats[name]?.games?(a.stats[name].last/a.stats[name].games*100).toFixed(1)+'%':'—');$('analysisSummary').innerHTML=[['半荘数',totalGames+'回'],['平均順位',avg],['トップ率',top],['ラス率',last],['累計ポイント',signed(points)+'pt'],['累計精算',money(moneyV)]].map(x=>'<div class="stat"><div class="stat-label">'+x[0]+'</div><div class="stat-value">'+x[1]+'</div></div>').join('');$('analysisTable').innerHTML=list.length?list.sort((a,b)=>b[1].points-a[1].points).map(([n,s])=>{const rankCell=r=>{const c=s.ranks?.[r]||0;return c+'回<br><small>'+((c/s.games)*100).toFixed(1)+'%</small>'};return '<tr><td>'+esc(n)+'</td><td>'+s.games+'</td><td>'+(s.rankSum/s.games).toFixed(2)+'</td><td>'+rankCell(1)+'</td><td>'+rankCell(2)+'</td><td>'+rankCell(3)+'</td><td>'+rankCell(4)+'</td><td>'+signed(s.points)+'</td><td>'+money(s.money)+'</td><td>'+signed(s.chips)+'</td></tr>'}).join(''):'<tr><td colspan="10">該当データなし</td></tr>';drawChart(name,mode,group,date)}
function drawChart(name,mode,group,date){const canvas=$('analysisChart'),ctx=canvas.getContext('2d'),dpr=devicePixelRatio||1,w=canvas.clientWidth||700,h=240;canvas.width=w*dpr;canvas.height=h*dpr;ctx.scale(dpr,dpr);ctx.clearRect(0,0,w,h);ctx.strokeStyle='#cbd5e1';ctx.lineWidth=1;ctx.beginPath();ctx.moveTo(40,15);ctx.lineTo(40,h-30);ctx.lineTo(w-10,h-30);ctx.stroke();if(name==='all'){ctx.fillStyle='#64748b';ctx.font='12px sans-serif';ctx.fillText('分析対象で個別メンバーを選ぶと累計推移を表示します',55,50);return}const games=data.games.filter(g=>(mode==='all'||String(g.mode)===String(mode))&&(group==='all'||g.groupId===group)&&(date==='all'||g.date===date)&&Object.values(g.names).includes(name)).sort((a,b)=>String(a.date).localeCompare(String(b.date)));let cum=0,pts=[0];games.forEach(g=>{const k=Object.keys(g.names).find(k=>g.names[k]===name);cum+=Number(g.scores[k])||0;pts.push(cum)});if(pts.length<2)return;const min=Math.min(...pts,0),max=Math.max(...pts,0),range=max-min||1;ctx.strokeStyle='#2563eb';ctx.lineWidth=2;ctx.beginPath();pts.forEach((p,i)=>{const x=40+(w-55)*i/(pts.length-1),y=15+(h-50)*(max-p)/range;i?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke();ctx.fillStyle='#475569';ctx.font='11px sans-serif';ctx.fillText(trim(max),4,18);ctx.fillText(trim(min),4,h-30);ctx.fillText('0',18,15+(h-50)*max/range)}
