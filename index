<!doctype html>
<html lang="ja">
<head>
<meta name="theme-color" content="#0b6b3f">

<link rel="manifest" href="./manifest.webmanifest">
<link rel="apple-touch-icon" href="./icon-192.png">

<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="麻雀戦績">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,user-scalable=no">
<title>麻雀戦績・精算マネージャー</title>
<style>
:root{--green:#0b6b3f;--green2:#14532d;--card:#fffdf6;--red:#b91c1c;--red2:#7f1d1d;--ink:#0f172a;--muted:#64748b;--line:#dbe3ea;--blue:#2563eb}
*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:system-ui,-apple-system,"Noto Sans JP",sans-serif;color:var(--ink);background:radial-gradient(circle at top,#0f9d58 0,var(--green) 42%,#053222 100%)}
button,input,select,textarea{font:inherit}.app{max-width:980px;margin:auto;padding:10px 10px 28px}.frame{background:linear-gradient(135deg,var(--green2),#064e3b);border-radius:18px;padding:10px;box-shadow:0 0 0 3px #022c22,0 12px 30px #0006}.header{display:flex;justify-content:space-between;gap:12px;align-items:center;color:#fffbea;margin:2px 2px 10px}.brand{display:flex;gap:8px;align-items:center;font-weight:800}.tile{display:grid;place-items:center;width:32px;height:32px;background:#fff7c2;color:var(--red);border:2px solid var(--red);border-radius:7px;box-shadow:0 2px 0 var(--red);font-weight:900}.sub{font-size:11px;opacity:.9;text-align:right}
.tabs{display:grid;grid-template-columns:repeat(5,1fr);gap:5px;margin-bottom:9px}.tab{border:0;border-radius:10px;padding:9px 4px;background:#dfe7e3;color:#193a2c;font-weight:700;cursor:pointer}.tab.active{background:#fff7c2;color:var(--red);box-shadow:inset 0 0 0 2px #f59e0b}.panel{display:none}.panel.active{display:block}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:11px;margin-bottom:10px;box-shadow:0 3px 0 #cbd5e1}.card h2,.card h3{margin:0 0 8px}.row{display:flex;gap:8px;flex-wrap:wrap}.grow{flex:1;min-width:140px}.grid2{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.field label{display:block;font-size:11px;color:#475569;margin:0 0 3px}.field input,.field select,.field textarea{width:100%;border:1px solid #cbd5e1;border-radius:9px;padding:9px;background:#f8fafc}.field input:focus,.field select:focus,.field textarea:focus{outline:0;border-color:#16a34a;box-shadow:0 0 0 2px #16a34a22;background:#fff}.btn{border:0;border-radius:999px;padding:10px 15px;background:var(--red);color:#fff;font-weight:700;cursor:pointer;box-shadow:0 3px 0 var(--red2)}.btn.secondary{background:#475569;box-shadow:0 3px 0 #1e293b}.btn.blue{background:#2563eb;box-shadow:0 3px 0 #1e40af}.btn.light{background:#e5e7eb;color:#111827;box-shadow:none}.btn.danger{background:#dc2626}.btn:active{transform:translateY(1px)}.controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:9px}.notice{font-size:12px;color:#475569;background:#f1f5f9;border-radius:9px;padding:8px}.error{color:#b91c1c;background:#fee2e2}.success{color:#166534;background:#dcfce7}.hidden{display:none!important}
.mode-switch{display:flex;gap:7px}.mode-btn{flex:1;border:1px solid #cbd5e1;background:#fff;border-radius:10px;padding:9px;font-weight:800}.mode-btn.active{background:#dcfce7;border-color:#16a34a;color:#166534}.totals{display:grid;gap:7px;margin:8px 0}.total-card{background:linear-gradient(90deg,#166534,#15803d);color:#fff;padding:9px;border-radius:11px;box-shadow:0 2px 0 #052e16}.total-main{font-weight:800}.rank{font-size:11px;opacity:.94;margin-top:3px}.plus{color:#93c5fd}.minus{color:#fca5a5}.zero{color:#fff}.auto{background:#ecfdf5!important;border-color:#22c55e!important}.small{font-size:11px;color:var(--muted)}
.collapse-head{display:flex;justify-content:space-between;align-items:center;gap:8px}.collapse-body{margin-top:9px}.settlement-result{margin-top:9px;display:grid;gap:6px}.settlement-line{display:flex;justify-content:space-between;gap:10px;padding:8px;border-radius:9px;background:#f1f5f9;font-weight:700}.settlement-line .money.plus{color:#2563eb}.settlement-line .money.minus{color:#dc2626}
.history{max-height:430px;overflow:auto}.history-item{border:1px solid #e2e8f0;border-radius:10px;padding:9px;margin-bottom:7px;background:#fffdf0}.history-top{display:flex;justify-content:space-between;gap:8px}.history-title{font-weight:800}.history-actions{display:flex;gap:5px}.mini{border:0;border-radius:7px;padding:4px 8px;cursor:pointer}.mini.edit{background:#e0e7ff}.mini.del{background:#fee2e2}.history-line{font-size:12px;margin-top:4px}.empty{text-align:center;color:#64748b;padding:18px}
.member-item,.group-item{display:flex;justify-content:space-between;gap:10px;align-items:center;border:1px solid #e2e8f0;border-radius:10px;padding:9px;margin-bottom:7px;background:#fff}.member-meta,.group-meta{font-size:11px;color:#64748b;margin-top:2px}.badge{display:inline-block;border-radius:999px;padding:2px 7px;font-size:10px;background:#e2e8f0;margin-right:4px}.analysis-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;padding:9px}.stat-label{font-size:11px;color:#64748b}.stat-value{font-size:18px;font-weight:850;margin-top:2px}.table-wrap{overflow:auto}.data-table{width:100%;border-collapse:collapse;font-size:12px}.data-table th,.data-table td{padding:7px;border-bottom:1px solid #e2e8f0;text-align:right;white-space:nowrap}.data-table th:first-child,.data-table td:first-child{text-align:left}.chart{width:100%;height:240px;border:1px solid #e2e8f0;border-radius:10px;background:#fff}.footer{color:#d1fae5;font-size:10px;text-align:center;margin-top:10px}
@media(max-width:760px){.tabs{grid-template-columns:repeat(3,1fr)}.grid4{grid-template-columns:repeat(2,1fr)}.analysis-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:520px){.header{align-items:flex-start}.sub{max-width:140px}.grid2,.grid3,.grid4{grid-template-columns:1fr}.totals{grid-template-columns:1fr!important}.analysis-grid{grid-template-columns:1fr}.btn{width:100%}.controls{flex-direction:column}.tabs{grid-template-columns:repeat(2,1fr)}}
</style>
</head>
<body><div class="app"><div class="frame">
<header class="header"><div class="brand"><span class="tile">麻</span><span>麻雀戦績・精算マネージャー</span></div><div class="sub">サンマ・ヨンマ対応<br>端末保存＋JSONバックアップ</div></header>
<nav class="tabs">
<button class="tab active" data-tab="game">対局入力</button><button class="tab" data-tab="members">メンバー</button><button class="tab" data-tab="groups">メンツ・ルール</button><button class="tab" data-tab="analysis">戦績分析</button><button class="tab" data-tab="settings">データ管理</button>
</nav>

<section id="game" class="panel active">
<div class="card"><div class="mode-switch"><button id="mode3" class="mode-btn active">三人打ち</button><button id="mode4" class="mode-btn">四人打ち</button></div></div>
<div class="card"><div class="row"><div class="field grow"><label>使用するメンツ・ルール</label><select id="gameGroup"></select></div><div class="field grow"><label>対局日</label><input id="gameDate" type="date"></div></div><div id="groupApplied" class="small" style="margin-top:5px"></div></div>
<div class="card"><div class="collapse-head"><h3>精算設定</h3><button id="toggleSettlement" type="button" class="btn light">精算項目を開く ▼</button></div><div id="settlementBody" class="collapse-body hidden">
<div class="grid2"><div class="field"><label>1ポイントの金額（円）</label><input id="rate" type="number" min="0" step="1" value="100"></div><div class="field"><label>チップ1枚の金額（円）</label><input id="chipRate" type="number" min="0" step="1" value="500"></div></div>
<div id="chipInputs" class="grid4" style="margin-top:8px"></div><div class="small">チップを使わない場合は0のままで記録できます。最後の1人は、合計0になるよう自動計算されます。</div>
<div class="controls"><button id="settleBtn" class="btn blue">精算を表示</button></div><div id="settlementMessage"></div><div id="settlementResult" class="settlement-result"></div>
</div></div>
<div id="totals" class="totals"></div>
<div class="card"><h3>半荘スコア入力</h3><div id="scoreInputs" class="grid4"></div><div class="field" style="margin-top:8px"><label>コメント</label><input id="comment" type="text" placeholder="例：親倍ツモ、接戦、役満など"></div><div id="inputMessage" style="margin-top:8px"></div><div class="controls"><button id="recordBtn" class="btn">🀄 計算して記録</button><button id="clearBtn" class="btn secondary">入力クリア</button><button id="resetHistoryBtn" class="btn secondary">履歴全リセット</button><button id="lineBtn" class="btn secondary">LINEで共有</button></div></div>
<div class="card"><h3>履歴</h3><div id="history" class="history"></div></div>
</section>

<section id="members" class="panel"><div class="card"><h2>メンバー管理</h2><div class="grid2"><div class="field"><label>名前</label><input id="memberName" type="text" placeholder="例：河路"></div><div class="field"><label>メモ</label><input id="memberNote" type="text" placeholder="例：会社メンバー"></div></div><div class="controls"><button id="addMemberBtn" class="btn">メンバー追加</button></div></div><div class="card"><h3>登録メンバー</h3><div id="memberList"></div></div></section>

<section id="groups" class="panel"><div class="card"><h2>メンツ・ルール保存</h2><div class="grid2"><div class="field"><label>グループ名</label><input id="groupName" type="text" placeholder="例：いつもの三麻"></div><div class="field"><label>形式</label><select id="groupMode"><option value="3">三人打ち</option><option value="4">四人打ち</option></select></div></div><div id="groupMemberSelects" class="grid4" style="margin-top:8px"></div><div class="grid4" style="margin-top:8px"><div class="field"><label>1ポイント（円）</label><input id="groupRate" type="number" value="100"></div><div class="field"><label>チップ1枚（円）</label><input id="groupChipRate" type="number" value="500"></div><div class="field"><label>持ち点</label><input id="groupStart" type="number" value="25000"></div><div class="field"><label>返し点</label><input id="groupReturn" type="number" value="30000"></div></div><div class="field" style="margin-top:8px"><label>ローカルルール・メモ</label><textarea id="groupRules" rows="3" placeholder="例：赤3枚、ウマ10-20、焼き鳥なし"></textarea></div><div class="controls"><button id="saveGroupBtn" class="btn">ルール保存</button><button id="cancelGroupEditBtn" class="btn light hidden">編集キャンセル</button></div></div><div class="card"><h3>保存済みメンツ・ルール</h3><div id="groupList"></div></div></section>

<section id="analysis" class="panel"><div class="card"><div class="row"><div class="field grow"><label>分析対象</label><select id="analysisMember"></select></div><div class="field grow"><label>日付</label><select id="analysisDate"></select></div><div class="field grow"><label>形式</label><select id="analysisMode"><option value="all">すべて</option><option value="3">三人打ち</option><option value="4">四人打ち</option></select></div><div class="field grow"><label>メンツ</label><select id="analysisGroup"></select></div></div></div><div id="analysisSummary" class="analysis-grid"></div><div class="card"><h3>累計推移</h3><canvas id="analysisChart" class="chart"></canvas></div><div class="card"><h3>メンバー別集計</h3><div class="table-wrap"><table class="data-table"><thead><tr><th>名前</th><th>半荘</th><th>平均順位</th><th>1位</th><th>2位</th><th>3位</th><th>4位</th><th>累計pt</th><th>累計円</th><th>チップ</th></tr></thead><tbody id="analysisTable"></tbody></table></div></div></section>

<section id="settings" class="panel"><div class="card"><h2>データ管理</h2><div class="notice">戦績・メンバー・ルールはこの端末のブラウザに保存されます。機種変更やブラウザのデータ削除に備えて、定期的にJSONバックアップしてください。</div><div class="controls"><button id="exportBtn" class="btn secondary">JSONバックアップ</button><label class="btn secondary" style="display:inline-flex;align-items:center;justify-content:center">JSON復元<input id="importFile" type="file" accept="application/json" hidden></label><button id="eraseAllBtn" class="btn danger">全データ削除</button></div></div></section>
<div class="footer">データはブラウザのlocalStorageへ保存されます。大切な戦績は定期的にJSONバックアップしてください。</div>
</div></div>
<script>
(()=>{'use strict';
const KEY='mahjong_manager_complete_v1';
const defaultData={members:[],groups:[],games:[],settings:{mode:3,rate:100,chipRate:500}};
let data=load();let editingGameId=null,editingGroupId=null;
const $=id=>document.getElementById(id), esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,8);
function load(){try{const x=JSON.parse(localStorage.getItem(KEY));return x&&x.members&&x.groups&&x.games?Object.assign({},defaultData,x,{settings:Object.assign({},defaultData.settings,x.settings||{})}):structuredClone(defaultData)}catch{return structuredClone(defaultData)}}
function save(){localStorage.setItem(KEY,JSON.stringify(data))}
function signed(n){n=Number(n)||0;return n>0?'+'+trim(n):trim(n)}function trim(n){return Number.isInteger(n)?String(n):String(Number(n.toFixed(2)))}function money(n){return (n>0?'+':'')+Math.round(n).toLocaleString('ja-JP')+'円'}
function membersForMode(mode){return data.members}
function currentMode(){return Number(data.settings.mode)||3}function playerKeys(){return currentMode()===3?['E','S','W']:['E','S','W','N']}
function currentNames(){const out={};playerKeys().forEach(k=>{const sel=$('player_'+k);out[k]=(sel&&sel.value)||windName(k)});return out}function windName(k){return({E:'東',S:'南',W:'西',N:'北'})[k]}
function rankCountsFor(names,modeFilter='all',groupFilter='all'){const counts={};Object.values(names).forEach(n=>counts[n]={1:0,2:0,3:0,4:0});data.games.filter(g=>(modeFilter==='all'||String(g.mode)===String(modeFilter))&&(groupFilter==='all'||g.groupId===groupFilter)).forEach(g=>{const arr=Object.keys(g.scores).map(k=>({name:g.names[k],v:Number(g.scores[k])||0})).sort((a,b)=>b.v-a.v);let rank=1,prev=null;arr.forEach((x,i)=>{if(prev!==null&&x.v<prev)rank=i+1;if(counts[x.name])counts[x.name][rank]++;prev=x.v})});return counts}
function totalsForCurrent(){const names=currentNames(),t={};Object.values(names).forEach(n=>t[n]=0);data.games.filter(g=>g.mode===currentMode()).forEach(g=>Object.keys(g.scores).forEach(k=>{if(t[g.names[k]]!==undefined)t[g.names[k]]+=Number(g.scores[k])||0}));return t}
function setMessage(id,text,type=''){const el=$(id);el.innerHTML=text?'<div class="notice '+type+'">'+esc(text)+'</div>':''}
function setupTabs(){document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab,.panel').forEach(x=>x.classList.remove('active'));b.classList.add('active');$(b.dataset.tab).classList.add('active');if(b.dataset.tab==='analysis')renderAnalysis()})}
function renderAll(){renderMode();renderMembers();renderGroups();renderGroupOptions();renderInputs();renderTotals();renderHistory();renderAnalysis()}
function renderMode(){const m=currentMode();$('mode3').classList.toggle('active',m===3);$('mode4').classList.toggle('active',m===4);$('groupMode').value=String(m)}
function changeMode(m){data.settings.mode=m;save();editingGameId=null;renderAll();clearGameInputs()}
function memberOptions(selected=''){return '<option value="">名前を直接入力</option>'+data.members.map(m=>'<option value="'+esc(m.name)+'" '+(m.name===selected?'selected':'')+'>'+esc(m.name)+'</option>').join('')}
function captureGameForm(){const state={comment:$('comment')?.value||'',group:$('gameGroup')?.value||'',players:{},scores:{},chips:{}};playerKeys().forEach(k=>{if($('player_'+k))state.players[k]=$('player_'+k).value;if($('score_'+k))state.scores[k]=$('score_'+k).value;if($('chip_'+k))state.chips[k]=$('chip_'+k).value});return state}
function restoreGameForm(state){if(!state)return;playerKeys().forEach(k=>{if($('player_'+k)&&state.players[k]!==undefined&&[...$('player_'+k).options].some(o=>o.value===state.players[k]))$('player_'+k).value=state.players[k];if($('score_'+k)&&state.scores[k]!==undefined)$('score_'+k).value=state.scores[k];if($('chip_'+k)&&state.chips[k]!==undefined)$('chip_'+k).value=state.chips[k]});if($('comment'))$('comment').value=state.comment||'';if($('gameGroup')&&state.group&&[...$('gameGroup').options].some(o=>o.value===state.group))$('gameGroup').value=state.group;updateChipLabels();autoFill('score');autoFill('chip')}
function renderInputs(preserve=true){const previous=preserve?captureGameForm():null,keys=playerKeys();$('scoreInputs').className='grid'+keys.length;$('chipInputs').className='grid'+keys.length;$('scoreInputs').innerHTML=keys.map((k,i)=>'<div><div class="field"><label>プレイヤー'+(i+1)+'</label><select id="player_'+k+'">'+memberOptions(windName(k))+'</select></div><div class="field" style="margin-top:5px"><label>スコア（+/-）</label><input id="score_'+k+'" type="number" step="0.1" placeholder="'+(i===keys.length-1?'自動計算':'例：25')+'"></div></div>').join('');$('chipInputs').innerHTML=keys.map((k,i)=>'<div class="field"><label id="chipLabel_'+k+'">'+esc(windName(k))+'のチップ枚数</label><input id="chip_'+k+'" type="number" step="1" value="0" '+(i===keys.length-1?'readonly aria-label="自動計算されるチップ枚数"':'')+'></div>').join('');keys.forEach((k,i)=>{$('player_'+k).addEventListener('change',()=>{updateChipLabels();renderTotals()});$('score_'+k).addEventListener('input',()=>autoFill('score'));if(i<keys.length-1)$('chip_'+k).addEventListener('input',()=>autoFill('chip'))});if(previous)restoreGameForm(previous);else{autoFill('chip');updateChipLabels()}}
function updateChipLabels(){playerKeys().forEach(k=>$('chipLabel_'+k).textContent=(($('player_'+k).value)||windName(k))+'のチップ枚数')}
function autoFill(type){const keys=playerKeys(),els=keys.map(k=>$(type+'_'+k));els.forEach(e=>e.classList.remove('auto'));if(type==='chip'){const last=els[els.length-1],sum=els.slice(0,-1).reduce((a,e)=>a+(e.value===''?0:(Number(e.value)||0)),0);last.value=trim(-sum);last.classList.add('auto');return}const blank=els.filter(e=>e.value==='');if(blank.length===1){const sum=els.filter(e=>e.value!=='').reduce((a,e)=>a+(Number(e.value)||0),0);blank[0].value=trim(-sum);blank[0].classList.add('auto')}}
function parseBalanced(type){autoFill(type);const keys=playerKeys(),vals={};let blanks=0;keys.forEach(k=>{let v=$(type+'_'+k).value;if(type==='chip'&&v==='')v='0';if(v==='')blanks++;else vals[k]=Number(v)});if(blanks>1)return{ok:false,msg:'スコアは最後の1人を除いて入力してください。'};if(keys.some(k=>!Number.isFinite(vals[k])))return{ok:false,msg:'数値を正しく入力してください。'};const sum=keys.reduce((a,k)=>a+vals[k],0);if(Math.abs(sum)>0.0001)return{ok:false,msg:(type==='score'?'スコア':'チップ')+'の合計が0ではありません（現在 '+signed(sum)+'）。'};return{ok:true,vals}}
function renderTotals(){const names=currentNames(),tot=totalsForCurrent(),counts=rankCountsFor(names,String(currentMode()),'all');const cols=currentMode();$('totals').style.gridTemplateColumns='repeat('+cols+',1fr)';$('totals').innerHTML=Object.values(names).map(n=>{const v=tot[n]||0,c=counts[n]||{};return '<div class="total-card"><div class="total-main '+(v>0?'plus':v<0?'minus':'zero')+'">'+esc(n)+': '+signed(v)+'</div><div class="rank">順位: '+Array.from({length:currentMode()},(_,i)=>(i+1)+'位'+(c[i+1]||0)+'回').join(' / ')+'</div></div>'}).join('')}
function currentGroup(){return data.groups.find(g=>g.id===$('gameGroup').value)}
function applyGroup(){const g=currentGroup();if(!g){$('groupApplied').textContent='';return}if(g.mode!==currentMode())changeMode(g.mode);data.settings.rate=g.rate;data.settings.chipRate=g.chipRate;$('rate').value=g.rate;$('chipRate').value=g.chipRate;renderInputs();const keys=playerKeys();keys.forEach((k,i)=>{if(g.members[i])$('player_'+k).value=g.members[i]});updateChipLabels();$('groupApplied').textContent='ルール: '+(g.rules||'設定なし')+' / 持ち点 '+g.start+' / 返し点 '+g.return;save();renderTotals()}
function recordGame(){const s=parseBalanced('score');if(!s.ok){setMessage('inputMessage',s.msg,'error');return}const c=parseBalanced('chip');if(!c.ok){setMessage('inputMessage',c.msg,'error');return}const names=currentNames();if(new Set(Object.values(names)).size!==Object.values(names).length){setMessage('inputMessage','同じプレイヤー名が重複しています。','error');return}const entry={id:editingGameId||uid(),mode:currentMode(),date:$('gameDate').value||new Date().toISOString().slice(0,10),groupId:$('gameGroup').value||'',names,scores:s.vals,chips:c.vals,rate:Number($('rate').value)||0,chipRate:Number($('chipRate').value)||0,comment:$('comment').value.trim(),createdAt:new Date().toISOString()};if(editingGameId){const i=data.games.findIndex(g=>g.id===editingGameId);data.games[i]=entry}else data.games.push(entry);editingGameId=null;data.settings.rate=entry.rate;data.settings.chipRate=entry.chipRate;save();clearGameInputs();renderAll();setMessage('inputMessage','記録しました。','success')}
function clearGameInputs(){playerKeys().forEach(k=>{if($('score_'+k))$('score_'+k).value='';if($('chip_'+k))$('chip_'+k).value=''});$('comment').value='';editingGameId=null;$('recordBtn').textContent='🀄 計算して記録';setMessage('inputMessage','');$('settlementResult').innerHTML='';setMessage('settlementMessage','')}
